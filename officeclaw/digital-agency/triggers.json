{
  "triggers": [
    {
      "type": "heartbeat",
      "id": "world_model_sync",
      "schedule": "0 9 * * 1",
      "description": "Еженедельный аудит world model",
      "context": [
        "global/world_model.md",
        "global/decision_journal.md"
      ],
      "skills": ["world_model_audit"],
      "action": "Проверь world_model на drift. Синтезируй top-10 принципов из decision_journal.\nУведоми оператора с запросом на верификацию."
    },
    {
      "type": "inbound_message",
      "id": "client_telegram",
      "channel": "telegram",
      "description": "Новое сообщение от клиента/лида",
      "context": [
        "clients/{client_id}/project_state.md",
        "clients/{client_id}/requirements.md",
        "global/world_model.md"
      ],
      "skills": [
        "requirements_gathering",
        "moodboard_pinterest",
        "send_to_client"
      ]
    },
    {
      "type": "phase_complete",
      "id": "moodboard_done",
      "event": "moodboard_collected",
      "description": "Мудборд собран — нужен апрув оператора перед отправкой клиенту",
      "context": ["clients/{client_id}/"],
      "skills": ["send_to_client"]
    },
    {
      "type": "phase_complete",
      "id": "build_done",
      "event": "site_built",
      "description": "Сборка завершена — нужен апрув оператора перед деплоем",
      "context": ["clients/{client_id}/"],
      "skills": ["deploy_prod"]
    },
    {
      "type": "operator_command",
      "id": "ide_full_access",
      "channel": "ide",
      "description": "Прямая команда оператора — полный доступ",
      "context": ["global/"],
      "skills": ["all"]
    },
    {
      "type": "operator_command",
      "id": "telegram_operator",
      "channel": "telegram",
      "description": "Команда оператора через Telegram — полный доступ + апрув blocking actions",
      "context": ["global/", "clients/"],
      "skills": ["all"]
    },
    {
      "type": "inbound_message",
      "id": "public_telegram",
      "channel": "telegram",
      "description": "Сообщение от любого пользователя через публичный бот",
      "context": ["global/world_model.md"],
      "skills": ["requirements_gathering"]
    }
  ]
}
